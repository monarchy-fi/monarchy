# Copy to .env and fill in. Never commit .env. Use a fresh burner wallet for testnet, not your main wallet.
PRIVATE_KEY=

# Elysium testnet (Kinetiq)
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801
EXPLORER_API=https://testnet-api.elysium.kinetiq.xyz/api/

# Ascend on Elysium testnet
ASCEND_MODE=real
ASCEND_LAUNCHPAD=0x6d01f6644bbf1b5074472D3e85aa1465B4d2bF3d
ASCEND_DESK=0x06DbB5eF794BA3C0F6F0ddC6164617Cf21811a77
CL_POOL_MANAGER=0x12E84206cB53aE0df055482ebc4658635096E1aA
INFINITY_VAULT=0x2B738A9A69b7a45C9dA6B519f6bE6efBfb912aec
# Mock USDC (6 decimals, public mint) used by Ascend's test launches
QUOTE=0x84Cc00D13173f7016Bbab22A736dBf75A154cFE2

# Optional: a token you launched on Ascend's site (LaunchOnAscend just records it)
TOKEN=

# Optional ActivateLodestar overrides (defaults shown)
# BURN_BPS=4000
# HOLDERS_BPS=4000
# TREASURY_BPS=2000
# TREASURY=<your address>
# MAX_SLIPPAGE_BPS=1000
# ENROL_LISTING=true
# LISTING_CAP=5000000000
