#!/usr/bin/env bash
# Offline solc shim: forge calls this instead of downloading a native solc.
# It wraps solcjs (the solc npm package) in standard-json mode.
if [ "$1" = "--version" ]; then
  echo "solc, the solidity compiler commandline interface"
  echo "Version: 0.8.28+commit.7893614a.Linux.g++"
  exit 0
fi
exec node "$(dirname "$0")/solcjs-stdjson.mjs"
