{
  "name": "monarchy",
  "version": "1.0.0",
  "description": "Monarchy: Lodestar fee router, Exile locks and Sandfall vesting for Ascend launches on Elysium",
  "scripts": {
    "build": "forge build",
    "build:offline": "FOUNDRY_PROFILE=offline forge build",
    "test": "forge test -vv",
    "test:offline": "FOUNDRY_PROFILE=offline forge test -vv",
    "abis": "node tools/export-abis.mjs",
    "demo:local": "tools/demo-local.sh",
    "deploy:testnet": "forge script contracts/script/DeployCore.s.sol:DeployCore --rpc-url $RPC_URL --broadcast --slow",
    "deploy:mocks": "forge script contracts/script/DeployMocks.s.sol:DeployMocks --rpc-url $RPC_URL --broadcast --slow && ASCEND_MODE=mock forge script contracts/script/DeployCore.s.sol:DeployCore --rpc-url $RPC_URL --broadcast --slow",
    "launch:testnet": "forge script contracts/script/LaunchOnAscend.s.sol:LaunchOnAscend --rpc-url $RPC_URL",
    "activate:testnet": "forge script contracts/script/ActivateLodestar.s.sol:ActivateLodestar --rpc-url $RPC_URL --broadcast --slow",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monarchy-fi/monarchy.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/monarchy-fi/monarchy/issues"
  },
  "homepage": "https://github.com/monarchy-fi/monarchy#readme",
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/cast": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "@openzeppelin/contracts": "^5.6.1",
    "solc": "^0.8.28"
  },
  "private": true
}
